generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  role     String  @default("STUDENT") // STUDENT, TEACHER, ADMIN
  name     String

  // Student specific
  group    String?
  course   String?
  capacity Int @default(5) // Тільки для викладачів: скільки максимум студентів
  studentProjects Project[] @relation("StudentProject")

  // Teacher specific
  teacherProjects Project[] @relation("TeacherProject")
  poolTeachers    PoolTeacher[]
}

model Project {
  id          String   @id @default(uuid())
  title       String   // Тема дипломного проєкту
  description String?  // Додаткова інформація
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  semester    String?  // Семестр/дисципліна
  
  proposedTitle String? // Нова тема (якщо студент подав запит на зміну)
  githubUrl     String? // Посилання на GitHub репозиторій
  
  studentId   String
  student     User     @relation("StudentProject", fields: [studentId], references: [id], onDelete: Cascade)
  
  teacherId   String
  teacher     User     @relation("TeacherProject", fields: [teacherId], references: [id], onDelete: Restrict)
  
  poolId      String?
  pool        Pool?    @relation(fields: [poolId], references: [id])

  chapters    Chapter[]
  documents   ProjectDocument[]
  
  requiresPublication Boolean @default(false)
  publications        String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, poolId])
}

model Chapter {
  id          String   @id @default(uuid())
  title       String   // e.g. "Розділ 1", "Розділ 2", "Розділ 3", "Розділ 4"
  order       Int      // 1, 2, 3, 4
  status      String   @default("PENDING") // PENDING, SUBMITTED, APPROVED, REWORK
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, order])
}

model ProjectDocument {
  id          String   @id @default(uuid())
  fileName    String   // Назва файлу (напр. "Курсова_Іванов.pdf")
  fileUrl     String   // Шлях до збереженого файлу на сервері
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Pool {
  id            String        @id @default(uuid())
  name          String
  year          Int           // напр. 2026
  semester      String        // напр. "1 семестр" або "2 півріччя"
  workType      String        // напр. "Курсова робота" або "Дипломна робота"
  groupPatterns String        // e.g. "ІПЗ-2*"
  teachers      PoolTeacher[]
  projects      Project[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PoolTeacher {
  id        String @id @default(uuid())
  poolId    String
  pool      Pool   @relation(fields: [poolId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  capacity  Int
  
  @@unique([poolId, teacherId])
}

model ImportedFile {
  id          String   @id @default(uuid())
  fileName    String
  fileUrl     String
  parsedData  String
  createdAt   DateTime @default(now())
}
